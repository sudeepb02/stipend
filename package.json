{
  "name": "stipend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:contract": "cd contract && RUSTFLAGS='--cfg near -C link-arg=-s' cargo build --target wasm32-unknown-unknown --release",
    "test:contract": "cd contract && cargo test",
    "agent": "node --env-file=.env demo-testnet/agent.ts",
    "control-plane": "node --env-file=.env demo-testnet/control-plane.ts",
    "create-budget": "node --env-file=.env demo-testnet/create-budget.ts",
    "deploy": "npm run build:contract && node --env-file=.env demo-testnet/deploy.ts",
    "fund-pot": "node --env-file=.env demo-testnet/fund-pot.ts",
    "mainnet:control-plane": "node --env-file=.env.mainnet demo-mainnet/control-plane.ts",
    "mainnet:create-budget": "node --env-file=.env.mainnet demo-mainnet/create-budget.ts",
    "mainnet:deploy": "node --env-file=.env.mainnet demo-mainnet/deploy.ts",
    "mainnet:fund-pot": "node --env-file=.env.mainnet demo-mainnet/fund-pot.ts",
    "mainnet:refund": "node --env-file=.env.mainnet demo-mainnet/refund.ts",
    "mainnet:stipend": "node --env-file=.env.mainnet cli/stipend.ts",
    "mainnet:verify": "node --env-file-if-exists=.env.mainnet demo-mainnet/verify.ts",
    "paid-api": "node --env-file=.env demo-testnet/paid-api/server.ts",
    "pay-with-wallet": "node --env-file=.env demo-testnet/paid-api/pay-with-wallet.ts",
    "refund": "node --env-file=.env demo-testnet/refund.ts",
    "scenario": "node --env-file=.env demo-testnet/scenario.ts",
    "setup:testnet": "node demo-testnet/setup-testnet.ts",
    "stipend": "node --env-file=.env cli/stipend.ts",
    "typecheck": "tsc",
    "verify": "node --env-file=.env.example --env-file-if-exists=.env demo-testnet/verify.ts"
  },
  "dependencies": {
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/express": "2.29.0",
    "@x402/fetch": "2.29.0",
    "express": "5.3.0",
    "near-api-js": "7.4.0",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
