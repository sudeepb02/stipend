# Template for .env.mainnet, read by the `npm run mainnet:*` scripts. Copy it to .env.mainnet,
# fill in the accounts and keys, and keep the copy private.

# NEAR mainnet. The CLI reads the RPC, the MPC signer and the explorer link from here.
NEAR_RPC_URL=https://free.rpc.fastnear.com
NEAR_SIGNER_ID=v1.signer
NEAR_EXPLORER_TX_URL=https://nearblocks.io/txns
STIPEND_CONTRACT_ID=
STIPEND_CONTRACT_KEY=
ORACLE_ID=
ORACLE_KEY=

# Base mainnet
BASE_EXPLORER_TX_URL=https://basescan.org/tx
FUNDER_PRIVATE_KEY=
PAID_API_PAY_TO=

# x402
X402_FACILITATOR_URL=https://facilitator.payai.network
PAID_API_PORT=4021
